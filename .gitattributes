# ────────────────────────────────────────────────
#  Line endings: enforce LF everywhere
# ────────────────────────────────────────────────
* text=auto eol=lf

# Source
*.ts text eol=lf
*.tsx text eol=lf
*.mjs text eol=lf
*.css text eol=lf
*.json text eol=lf
*.md text eol=lf

# Web assets
*.svg text eol=lf
*.webmanifest text eol=lf

# Treat binary assets as binary
*.webp binary
*.woff binary
*.woff2 binary
