# ─────────────────────────────────────────────
# TaskBoard - Git Attributes
# ─────────────────────────────────────────────

# ── Line Endings ──
* text=auto eol=lf

# ── Source ──
*.ts text eol=lf
*.tsx text eol=lf
*.mjs text eol=lf
*.css text eol=lf
*.json text eol=lf
*.md text eol=lf

# ── Web Assets ──
*.svg text eol=lf
*.webmanifest text eol=lf

# ── Binary Assets ──
*.webp binary
*.woff binary
*.woff2 binary
