# ─────────────────────────────────────────────
# TaskBoard - Environment Variables
# ─────────────────────────────────────────────

# ── Session Security ──
# Random string of at least 32 characters used to sign session cookies
# and API tokens. Generate one with: openssl rand -base64 48
SESSION_SECRET=your-secret-key-here

# ── Reverse Proxy ──
# Set to true only when running behind a trusted reverse proxy that sets
# X-Forwarded-For. Enables per-IP rate limiting. Leave unset otherwise.
# TRUST_PROXY=true
